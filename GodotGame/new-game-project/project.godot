; Engine configuration file.
config_version=5

[application]

config/name="DBZ Supersonic Warriors 2 (Port)"
config/description="Faithful Godot port of Dragon Ball Z: Supersonic Warriors 2 (DS, EU) built from the owner's dump."
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://port_icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="DBZSSW2Port"

[autoload]

Game="*res://scripts/core/game.gd"
Assets="*res://scripts/core/assets.gd"
Pilot="*res://scripts/pilot/pilot.gd"
Sound="*res://scripts/audio/sound.gd"

[display]

window/size/viewport_width=256
window/size/viewport_height=384
window/size/window_width_override=512
window/size/window_height_override=768
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

